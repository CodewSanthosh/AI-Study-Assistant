# ==========================================
# AI STUDY ASSISTANT - ENVIRONMENT CONFIG
# ==========================================

# 1. Database Connection (PostgreSQL + pgvector)
# - Local Docker Compose: postgresql+psycopg2://ai_study_user:local_password@localhost:5432/ai_study_db
# - Cloud (AWS RDS / Supabase / Neon): postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgresql+psycopg2://ai_study_user:local_password@localhost:5432/ai_study_db

# 2. Google Gemini API Key (Required for Text Embeddings & AI Tutor Chat)
# Get a free key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# 3. AWS S3 Configuration (Optional for local testing)
# If left blank, the app will automatically save uploaded files locally to backend/uploads/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
